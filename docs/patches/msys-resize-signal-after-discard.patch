+/* Called with input_mutex held. Geometry queries and output refresh
+   con.dwWinSize independently, so use the shared tty size to remember
+   what was last reported to the foreground process group. */
+static bool
+console_window_size_changed (tty_min *ttyp, COORD size)
+{
+  if (ttyp->winsize.ws_row == size.Y && ttyp->winsize.ws_col == size.X)
+    return false;
+  ttyp->winsize.ws_row = size.Y;
+  ttyp->winsize.ws_col = size.X;
+  return true;
+}
